{
  "name": "earthforge",
  "private": true,
  "license": "MIT",
  "version": "0.2.0-alpha.2",
  "type": "module",
  "description": "Synthetic sedimentary-basin velocity models from geological history, with numerical benchmarks and geological reference comparisons.",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview --host 127.0.0.1",
    "package:web": "node scripts/package-web.mjs",
    "build": "npm run build:rust && tsc --noEmit && vite build --configLoader runner",
    "build:pages": "npm run build -- --base=/earthforge/",
    "check": "tsc --noEmit",
    "test": "node --test --test-concurrency=2 tests/*.test.mjs",
    "test:numerics": "npm run build:native && node validation/rust/numerics.mjs",
    "test:numerics:reference": "node validation/numerics/run.mjs",
    "calibrate:force2020": "node validation/force2020/calibrate.mjs",
    "context:force2020": "node validation/force2020/context-scenarios.mjs",
    "build:rust": "node scripts/build-rust.mjs",
    "build:native": "node scripts/build-rust.mjs --native",
    "test:rust": "cargo test --locked --release",
    "test:parity": "npm run build:native && npm run build:rust && node validation/rust/compare.mjs",
    "test:acceptance": "npm run build:native && node validation/rust/checks.mjs",
    "pretest": "npm run build:rust",
    "predev": "npm run build:rust"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
